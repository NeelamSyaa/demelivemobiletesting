<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mobile Parallel Suite">
  <test name="Android Pixel">
        <parameter name="platformName" value="Android"/>
        <parameter name="deviceName" value="Pixel"/>
        <parameter name="udid" value="emulator-5554"/>
        <parameter name="appiumPort" value="4723"/>
        <parameter name="systemPort" value="8201"/>

        <classes>
            <class name="MobileTest"/>
        </classes>
    </test>

    <test name="Android Samsung">
        <parameter name="platformName" value="Android"/>
        <parameter name="deviceName" value="Samsung"/>
        <parameter name="udid" value="R58M123456"/>
        <parameter name="appiumPort" value="4724"/>
        <parameter name="systemPort" value="8202"/>

        <classes>
            <class name="MobileTest"/>
        </classes>
    </test>

    <test name="iPhone">
        <parameter name="platformName" value="iOS"/>
        <parameter name="deviceName" value="iPhone 15"/>
        <parameter name="udid" value="YOUR_IOS_UDID"/>
        <parameter name="appiumPort" value="4725"/>
        <parameter name="systemPort" value="8203"/>

        <classes>
            <class name="MobileTest"/>
        </classes>
    </test>
</suite> <!-- Suite -->
